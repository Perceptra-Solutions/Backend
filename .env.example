# ---------------------------------------------------------------------
# Perceptra Backend — ambiente local. NAO versionado (ver .gitignore).
# Copie de .env.example e preencha. Gere segredos, nao invente string.
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=perceptra

# --- Banco -----------------------------------------------------------
# Com Docker (recomendado):  npm run docker:up
#   O compose sobe o Postgres 18 e a API. Para rodar a API fora do
#   container contra o banco do container, a URL abaixo ja serve.
# Sem Docker: Neon (https://neon.tech) ou winget install PostgreSQL.PostgreSQL.17
DATABASE_URL=postgresql://perceptra:perceptra@localhost:5432/qualidade_obra
DATABASE_URL_TEST=postgresql://perceptra:perceptra@localhost:5432/qualidade_obra_test
DATABASE_SSL=false

# Credenciais do container Postgres (lidas pelo docker-compose.yml).
POSTGRES_USER=perceptra
POSTGRES_PASSWORD=perceptra
POSTGRES_DB=qualidade_obra
POSTGRES_PORT=5432

# --- Auth ------------------------------------------------------------
JWT_SECRET=gere-com-node-e-console-log-require-node-crypto-randomBytes-48-toString-base64url
JWT_EXPIRATION=1d
BCRYPT_COST=10

# --- Evidencia (cadeia de custodia) ----------------------------------
# s3 = Cloudflare R2 / AWS S3 | local = disco, para demo offline
EVIDENCIA_STORAGE_DRIVER=local
EVIDENCIA_STORAGE_PATH=./storage/evidencias
EVIDENCIA_TMP_PATH=./storage/tmp
EVIDENCIA_MAX_BYTES=209715200
EVIDENCIA_MIME_PERMITIDOS=image/jpeg,image/png,image/webp,video/mp4,application/pdf

# Preencha ao trocar EVIDENCIA_STORAGE_DRIVER para s3:
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=perceptra-evidencias
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_URL_TTL_SEGUNDOS=300

# --- Camera / dispositivo --------------------------------------------
# AES-256-GCM: exatamente 32 bytes em base64. O DBML manda nunca gravar
# url_stream em texto plano (ela carrega usuario:senha do RTSP).
CAMERA_URL_STREAM_ENC_KEY=gere-com-node-e-randomBytes-32-toString-base64
CAMERA_HEARTBEAT_TIMEOUT_SEGUNDOS=300
DEVICE_API_KEY_PEPPER=gere-com-node-e-randomBytes-32-toString-hex

# --- Monitoramento (AWS: pipeline de EPI/fissura da Raspberry Pi) ----
# Ver ARQUITETURA_AWS.md. Bucket/regiao/fila sao publicos (so endereco de
# recurso); as duas ultimas SAO segredo — gere uma access key para o
# usuario IAM "web-backend-epis" e cole aqui, nunca comite valor real.
# Sem essas duas, o backend sobe normal e so nao inicia o consumidor da fila
# (loga um aviso, nao derruba a API).
MONITORAMENTO_AWS_REGION=sa-east-1
MONITORAMENTO_AWS_BUCKET=perceptra-epis-1
MONITORAMENTO_AWS_QUEUE_URL=https://sqs.sa-east-1.amazonaws.com/609330996177/fila-resultados-web
MONITORAMENTO_AWS_ACCESS_KEY_ID=
MONITORAMENTO_AWS_SECRET_ACCESS_KEY=
MONITORAMENTO_URL_TTL_SEGUNDOS=300

# --- Operacional -----------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
